      "type": "object",
      "description": "Client -> server. 'id' is optional and echoed back as req_id.",
      "required": [
        "type",
        "action"
      ],
      "properties": {
        "type": {
          "const": "cmd"
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "player": {
          "type": "string",
          "maxLength": 24
        },
        "action": {
          "enum": [
            "launch_jammer",
            "clear_jammers",
            "toggle_ai",
            "set_view",
            "run_benchmark",
            "security_test",
            "load_scenario",
            "exit_scenario",
            "play",
            "pause",
            "set_speed",
            "restart",
            "replay"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "launch_jammer"
              }
            }
          },
          "then": {
            "required": [
              "jammer_type",
              "pos"
            ],
            "properties": {
              "jammer_type": {
                "$ref": "#/$defs/jammer_type"
              },
