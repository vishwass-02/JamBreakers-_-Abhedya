                "$ref": "#/$defs/vec2"
              },
              "power_dbm": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "toggle_ai"
              }
            }
          },
          "then": {
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_view"
              }
            }
          },
          "then": {
            "required": [
              "view"
            ],
            "properties": {
              "view": {
                "enum": [
                  "single",
                  "side_by_side"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "run_benchmark"
              }
            }
          },
          "then": {
            "properties": {
              "seed": {
                "type": "integer"
              },
              "duration_s": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              },
              "seeds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "quick": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "security_test"
              }
            }
          },
          "then": {
            "required": [
              "test"
            ],
            "properties": {
              "test": {
                "enum": [
                  "legit",
                  "tamper",
                  "spoof",
                  "replay",
                  "eavesdrop",
                  "desync",
                  "impersonate",
                  "capture",
                  "reboot",
                  "clock_loss"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "load_scenario"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "border_convoy",
                  "urban_patrol",
                  "coastal_watch",
                  "forest_ambush",
                  "airbase_spoof",
                  "relief_camp",
                  "drone_delivery"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "set_speed"
              }
            }
          },
          "then": {
            "required": [
              "speed"
            ],
            "properties": {
              "speed": {
                "enum": [
            1,
            2,
            4,
            10
          ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "replay"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.-]+$"
              }
            }
          }
        }
      ]
    },
