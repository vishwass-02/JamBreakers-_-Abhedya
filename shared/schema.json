{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-link.local/schema/1.0",
  "title": "ABHEDYA WebSocket message contract",
  "description": "Every message on /ws in either direction. Server->client messages use the envelope {v, type, t, src}. Client->server messages are commands {type:'cmd', action, ...}. Version 1.0. Change 'v' when a breaking change is made.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/spectrum"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/decision"
    },
    {
      "$ref": "#/$defs/security"
    },
    {
      "$ref": "#/$defs/score"
    },
    {
      "$ref": "#/$defs/benchmark"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/cmd"
    },
    {
      "$ref": "#/$defs/replay"
    }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": [
        "v",
        "type",
        "t",
        "src"
      ],
      "properties": {
        "v": {
          "const": "1.0"
        },
        "type": {
          "type": "string"
        },
        "t": {
          "type": "number",
          "description": "Server wall-clock time, seconds since Unix epoch"
        },
        "src": {
          "type": "string",
          "description": "Sender, e.g. 'server', 'sim', 'fake_world'"
        }
      }
    },
    "world_id": {
      "enum": [
        "main",
        "ai_off",
        "ai_on"
      ],
      "description": "'main' in single view. In side_by_side view the server sends one message per world: 'ai_off' and 'ai_on'."
    },
    "channel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "[x, y, z] metres; x east, y north, z up"
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, y] metres"
    },
    "jammer_type": {
      "enum": [
        "barrage",
        "random",
        "sweep",
        "reactive",
        "deceptive",
        "accidental",
        "follower",
        "smart",
        "novel"
      ]
    },
    "cnn_class": {
      "enum": [
        "clean",
        "barrage",
        "random",
        "sweep",
        "reactive",
        "deceptive",
        "accidental"
      ]
    },
    "level": {
      "enum": [
        "info",
        "warn",
        "alert",
        "good"
      ]
    },
    "action_taken": {
      "enum": [
        "hop",
        "fast_hop",
        "raise_power",
        "relay",
        "lower_rate",
        "hold",
        "ignore",
        "none",
        "survival",
        "undo"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "pos",
        "channel"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "command_post",
            "drone",
            "vehicle",
            "relay"
          ]
        },
        "pos": {
          "$ref": "#/$defs/vec3"
        },
        "heading_deg": {
          "type": "number"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "tx_power_dbm": {
          "type": "number"
        },
        "modulation": {
          "enum": [
            "QPSK",
            "BPSK",
            "BPSK_R2"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "rejoining",
            "returning",
            "charging"
          ]
        },
        "parent": {
          "type": "string",
          "description": "Next hop towards the command post"
        },
        "battery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Drones: battery level (drains 5x faster than real for the demo)"
        },
        "trip": {
          "type": "object",
          "description": "Vehicle trip: driving source → destination, waiting, then back.",
          "required": [
            "from",
            "to",
            "state",
            "progress",
            "eta_s",
            "src",
            "dst",
            "src_pos",
            "dst_pos"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "state": {
              "enum": [
                "driving",
                "unloading",
                "returning",
                "loading"
              ]
            },
            "progress": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "eta_s": {
              "type": "number",
              "minimum": 0
            },
            "src": {
              "type": "string"
            },
            "dst": {
              "type": "string"
            },
            "src_pos": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dst_pos": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "a",
        "b",
        "sinr_db",
        "status"
      ],
      "properties": {
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        },
        "sinr_db": {
          "type": "number"
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "delivery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "routed": {
          "type": "boolean",
          "description": "true if this link is on the active route to the command post"
        }
      }
    },
    "jammer": {
      "type": "object",
      "required": [
        "id",
        "type",
        "pos",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/jammer_type"
        },
        "pos": {
          "$ref": "#/$defs/vec3"
        },
        "power_dbm": {
          "type": "number"
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          },
          "description": "Channels currently being hit"
        },
        "active": {
          "type": "boolean"
        },
        "owner": {
          "type": "string",
          "description": "Player name who launched it"
        },
        "airborne": {
          "type": "boolean"
        },
        "tactic": {
          "type": "string",
          "enum": [
            "follow",
            "predict",
            "wide",
            "pulse",
            "spoof"
          ],
          "description": "Smart jammer: the tactic its bandit is using this second"
        },
        "tactic_values": {
          "type": "object",
          "description": "Smart jammer: learned success rate (0..1) of each tactic against this defence",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "estimate": {
      "type": "object",
      "required": [
        "pos",
        "radius_m"
      ],
      "properties": {
        "jammer_id": {
          "type": "string",
          "description": "Ground-truth id (for scoring only; the AI does not know it)"
        },
        "pos": {
          "$ref": "#/$defs/vec2"
        },
        "radius_m": {
          "type": "number",
          "minimum": 0,
          "description": "95 % uncertainty radius"
        }
      }
    },
    "obstacle": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "pos",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "building",
            "hill"
          ]
        },
        "pos": {
          "$ref": "#/$defs/vec2"
        },
        "size": {
          "$ref": "#/$defs/vec3",
          "description": "[width, depth, height] metres"
        },
        "loss_db": {
          "type": "number"
        }
      }
    },
    "kpis": {
      "type": "object",
      "required": [
        "delivery_pct",
        "hop_latency_ms",
        "outage_ms",
        "hops",
        "frames_verified",
        "frames_rejected"
      ],
      "properties": {
        "delivery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hop_latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "Median detect-to-hop latency (first jammed slot -> both ends on new channel). null until the first hop."
        },
        "hop_latency_p95_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "outage_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Total time the route to the command post was down"
        },
        "healthy_links": {
          "type": "integer",
          "minimum": 0
        },
        "total_links": {
          "type": "integer",
          "minimum": 0
        },
        "hops": {
          "type": "integer",
          "minimum": 0
        },
        "decision_time_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "CNN + policy compute time for the last decision"
        },
        "frames_verified": {
          "type": "integer",
          "minimum": 0
        },
        "frames_rejected": {
          "type": "integer",
          "minimum": 0
        },
        "frames_forged": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_total_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Since the start of the run (delivery_pct is the last 1 s)"
        },
        "frames_forged_accepted": {
          "type": "integer",
          "minimum": 0,
          "description": "Forged frames that got through. Must be 0."
        },
        "auth_syncs": {
          "type": "integer",
          "minimum": 0,
          "description": "Authenticated control frames applied"
        },
        "key_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_attack_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "Delivery while a jammer was on the air"
        },
        "safety_fixes": {
          "type": "integer",
          "minimum": 0,
          "description": "AI actions corrected or dropped by the safety guard"
        },
        "safety_undos": {
          "type": "integer",
          "minimum": 0,
          "description": "AI actions undone because they made delivery worse"
        },
        "resync_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "Median time for an out-of-sync node to rejoin via the rendezvous channel"
        },
        "out_of_sync": {
          "type": "integer",
          "minimum": 0,
          "description": "Nodes currently out of sync (missed a control frame)"
        },
        "clock_error_us": {
          "type": "number",
          "minimum": 0
        },
        "time_master": {
          "type": "string"
        },
        "qos": {
          "type": "object",
          "description": "Per message class: sent, delivered_pct, on_time_pct, latency p50/p95 (sim/qos.py)"
        }
      }
    },
    "hello": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "session_id",
        "schema_version",
        "channels_mhz",
        "bounds",
        "ai_enabled",
        "view"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "session_id": {
          "type": "string"
        },
        "server_version": {
          "type": "string"
        },
        "schema_version": {
          "const": "1.0"
        },
        "world_source": {
          "enum": [
            "fake",
            "sim"
          ],
          "description": "'fake' means placeholder data for UI work"
        },
        "signal_backend": {
          "enum": [
            "gnuradio",
            "numpy",
            "none"
          ]
        },
        "tick_hz": {
          "type": "number"
        },
        "slot_ms": {
          "type": "number"
        },
        "channels_mhz": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "fft_bins": {
          "type": "integer"
        },
        "bounds": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/vec2"
            },
            "y": {
              "$ref": "#/$defs/vec2"
            }
          }
        },
        "jammer_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jammer_type"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cnn_class"
          }
        },
        "ai_enabled": {
          "type": "boolean"
        },
        "view": {
          "enum": [
            "single",
            "side_by_side"
          ]
        },
        "key_fingerprint": {
          "type": "string",
          "description": "Public fingerprint of the mission key, never the key"
        },
        "ai_off_defender": {
          "type": "string"
        },
        "ai_on_defender": {
          "type": "string"
        },
        "obstacles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obstacle"
          }
        },
        "mission": {
          "type": "integer"
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "type": "string"
        },
        "time_of_day": {
          "type": "string"
        },
        "scenarios": {
          "type": "array"
        },
        "leaderboard": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "player",
              "attacks"
            ],
            "properties": {
              "player": {
                "type": "string"
              },
              "attacks": {
                "type": "integer",
                "minimum": 0
              },
              "damage": {
                "type": "number",
                "description": "Packets lost caused, %·s"
              }
            }
          }
        }
      }
    },
    "state": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "world",
        "tick",
        "sim_time_s",
        "ai_enabled",
        "view",
        "nodes",
        "links",
        "jammers",
        "kpis"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "world": {
          "$ref": "#/$defs/world_id"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "sim_time_s": {
          "type": "number",
          "minimum": 0
        },
        "ai_enabled": {
          "type": "boolean"
        },
        "view": {
          "enum": [
            "single",
            "side_by_side"
          ]
        },
        "mode": {
          "enum": [
            "arena",
            "scenario"
          ]
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "speed": {
          "enum": [
            1,
            2,
            4,
            10
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "jammers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jammer"
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/estimate"
          }
        },
        "obstacles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obstacle"
          }
        },
        "kpis": {
          "$ref": "#/$defs/kpis"
        },
        "defender": {
          "enum": [
            "none",
            "fixed_hopping",
            "energy",
            "aegis",
            "rl",
            "hybrid",
            "fhss_keyed",
            "max_power",
            "afh_power"
          ],
          "description": "Who is defending this world"
        },
        "hop_mode": {
          "enum": [
            "dwell",
            "fixed",
            "keyed"
          ],
          "description": "dwell = stay on one channel; fixed = public FHSS pattern; keyed = HMAC sequence per slot"
        },
        "blacklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "anti_follow": {
          "type": "boolean",
          "description": "Keyed mode is also avoiding the last 3 channels (follower detected)"
        },
        "scenario_t": {
          "type": "number"
        },
        "scenario_duration": {
          "type": "number"
        },
        "focus": {
          "type": "string",
          "enum": [
            "ai_on",
            "ai_off"
          ],
          "description": "Scenario: which defence the screens show"
        }
      }
    },
    "spectrum": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "world",
        "node_id",
        "bins"
      ],
      "properties": {
        "type": {
          "const": "spectrum"
        },
        "world": {
          "$ref": "#/$defs/world_id"
        },
        "node_id": {
          "type": "string",
          "description": "Receiver whose FFT this is"
        },
        "f_start_mhz": {
          "type": "number"
        },
        "f_stop_mhz": {
          "type": "number"
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 128,
          "maxItems": 128,
          "description": "Power per bin, dBm"
        },
        "anomaly": {
          "type": "boolean"
        },
        "probs": {
          "type": "object",
          "description": "CNN class probabilities, sum ~1",
          "propertyNames": {
            "$ref": "#/$defs/cnn_class"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/cnn_class"
            },
            {
              "const": "unknown"
            }
          ],
          "description": "CNN class, or 'unknown' when the fingerprint is outside every known class (ai/ood.py)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gradcam": {
          "type": "array",
          "description": "Optional 12 time rows x 32 frequency columns, values 0..1",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 32,
            "maxItems": 32
          }
        },
        "novelty": {
          "type": "number",
          "minimum": 0,
          "description": "Fingerprint distance / 99th-percentile range of the predicted class (> 2 = unknown)"
        },
        "behaviours": {
          "type": "object",
          "description": "Multi-label assessment: behaviours present at once (ai/behaviours.py)",
          "properties": {
            "detected": {
              "type": "array",
              "items": {
                "enum": [
                  "wideband",
                  "tracking",
                  "narrowband",
                  "intermittent",
                  "unknown"
                ]
              }
            },
            "scores": {
              "type": "object"
            },
            "evidence": {
              "type": "object"
            }
          }
        },
        "referee": {
          "type": "object",
          "properties": {
            "context": {
              "enum": [
                "steady",
                "stacked",
                "volatile"
              ]
            },
            "leader": {
              "enum": [
                "aegis",
                "rl"
              ]
            }
          }
        }
      }
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "level",
        "text"
      ],
      "properties": {
        "type": {
          "const": "event"
        },
        "world": {
          "$ref": "#/$defs/world_id"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "text": {
          "type": "string",
          "description": "Plain English, shown to the operator"
        },
        "req_id": {
          "type": "string",
          "description": "Echo of the command id that caused this, if any"
        },
        "caption": {
          "type": "boolean"
        },
        "step": {
          "type": "integer"
        },
        "steps": {
          "type": "integer"
        },
        "focus": {
          "type": "string",
          "enum": [
            "ai_on",
            "ai_off"
          ],
          "description": "Scenario: screens switch to this defence"
        }
      }
    },
    "decision": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "type",
        "world",
        "sim_time_s",
        "class",
        "confidence",
        "action"
      ],
      "properties": {
        "type": {
          "const": "decision"
        },
        "world": {
          "$ref": "#/$defs/world_id"
        },
        "sim_time_s": {
          "type": "number"
        },
        "class": {
          "enum": [
            "clean",
            "barrage",
            "random",
            "sweep",
            "reactive",
            "deceptive",
            "accidental",
            "unknown"
          ],
          "description": "CNN class, or 'unknown' for defenders that do not classify (energy detector)"
        },
        "confidence": {
          "type": "number",
